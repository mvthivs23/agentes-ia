#!/usr/bin/env python3
"""Smoke test for the pentest-assistant Ollama model.

Runs three probe prompts and asserts that every response contains the four
mandatory sections. Uses the official Ollama Python client so we exercise the
same code path production callers will.
"""

from __future__ import annotations

import os
import sys
from dataclasses import dataclass

import ollama

MODEL = os.environ.get("PA_MODEL", "pentest-assistant")
HOST = os.environ.get("OLLAMA_HOST", "http://127.0.0.1:11434")

REQUIRED_SECTIONS = ("## Summary", "## Steps", "## Detection", "## Cleanup")

PROBES = [
    "I have a foothold on a Linux box as www-data. Where do I look first for a local privesc?",
    "Web app returns 500 on ?id=1' but 200 on ?id=1. How should I confirm SQLi?",
    "Nmap shows TCP/5985 open on a Windows host. Walk me through initial access.",
]


@dataclass
class ProbeResult:
    prompt: str
    ok: bool
    missing: list[str]
    excerpt: str


def run_probe(prompt: str) -> ProbeResult:
    client = ollama.Client(host=HOST)
    resp = client.chat(
        model=MODEL,
        messages=[{"role": "user", "content": prompt}],
    )
    body = resp["message"]["content"]
    missing = [s for s in REQUIRED_SECTIONS if s not in body]
    return ProbeResult(
        prompt=prompt,
        ok=not missing,
        missing=missing,
        excerpt=body[:400] + ("..." if len(body) > 400 else ""),
    )


def main() -> int:
    results = [run_probe(p) for p in PROBES]
    failures = [r for r in results if not r.ok]

    for r in results:
        status = "PASS" if r.ok else "FAIL"
        print(f"[{status}] {r.prompt}")
        if r.missing:
            print(f"       missing sections: {', '.join(r.missing)}")
        print(f"       excerpt: {r.excerpt}\n")

    if failures:
        print(f"{len(failures)}/{len(results)} probes failed section check.")
        return 1
    print(f"All {len(results)} probes returned the required sections.")
    return 0


if __name__ == "__main__":
    sys.exit(main())

