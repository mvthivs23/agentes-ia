#!/usr/bin/env python3
"""recon-triage — rank Nmap-discovered hosts by likely attack value using a
local LLM. Reads Nmap XML, calls Ollama with a structured triage prompt,
validates the JSON response, and emits ranked JSON on stdout."""

from __future__ import annotations

import json
import os
import re
import sys
from dataclasses import asdict, dataclass
from pathlib import Path

import ollama
import typer
from lxml import etree
from rich.console import Console
from rich.table import Table

CHAT_MODEL = os.environ.get("OLLAMA_CHAT_MODEL", "llama3.1:8b")
OLLAMA_HOST = os.environ.get("OLLAMA_HOST", "http://127.0.0.1:11434")

app = typer.Typer(add_completion=False, help="AI-assisted Nmap recon triage.")
console = Console(stderr=True)


@dataclass
class Port:
    port: int
    proto: str
    service: str
    product: str
    version: str


@dataclass
class Host:
    ip: str
    hostname: str
    ports: list[Port]


SYSTEM = """You are a senior red-team operator triaging Nmap results for a
time-boxed engagement. For each host you receive, return a JSON object with:

  - "ip": the host IP (verbatim from the input)
  - "score": integer 0-100. 100 = highest attack value (domain controller,
    unauthenticated RCE candidate, credential store). 0 = no attack value.
  - "rationale": one sentence explaining the score
  - "vectors": array of up to three objects, each with keys:
      "technique": short name, e.g. "SMB relay"
      "attack_id": MITRE ATT&CK ID, e.g. "T1557.001"
      "note": one sentence, concrete next step

Return ONLY a top-level JSON array of these host objects. No prose, no markdown
code fences. If a host has no ports or is not interesting, still return an entry
with score 0 and rationale explaining why.
"""


def parse_nmap(path: Path) -> list[Host]:
    tree = etree.parse(str(path))
    hosts: list[Host] = []
    for hnode in tree.findall(".//host"):
        state = hnode.find("status")
        if state is None or state.get("state") != "up":
            continue
        addr_node = hnode.find("address[@addrtype='ipv4']")
        if addr_node is None:
            continue
        ip = addr_node.get("addr", "")
        hn_node = hnode.find(".//hostname")
        hostname = hn_node.get("name", "") if hn_node is not None else ""
        ports: list[Port] = []
        for p in hnode.findall(".//port"):
            st = p.find("state")
            if st is None or st.get("state") != "open":
                continue
            svc = p.find("service")
            ports.append(
                Port(
                    port=int(p.get("portid", "0")),
                    proto=p.get("protocol", ""),
                    service=svc.get("name", "") if svc is not None else "",
                    product=svc.get("product", "") if svc is not None else "",
                    version=svc.get("version", "") if svc is not None else "",
                )
            )
        hosts.append(Host(ip=ip, hostname=hostname, ports=ports))
    return hosts


def build_prompt(hosts: list[Host]) -> str:
    lines = ["Hosts to triage:\n"]
    for h in hosts:
        lines.append(f"- {h.ip} ({h.hostname or 'no-hostname'})")
        for p in h.ports:
            lines.append(
                f"    {p.port}/{p.proto}  {p.service}  {p.product} {p.version}".rstrip()
            )
    lines.append("\nRespond with the JSON array as instructed.")
    return "\n".join(lines)


def extract_json_array(raw: str) -> list[dict]:
    """Best-effort recovery of a JSON array from the model output."""
    raw = raw.strip()
    raw = re.sub(r"^```(?:json)?", "", raw)
    raw = re.sub(r"```$", "", raw)
    start = raw.find("[")
    end = raw.rfind("]")
    if start == -1 or end == -1:
        raise ValueError("no JSON array found in model output")
    return json.loads(raw[start : end + 1])


def validate(items: list[dict], hosts: list[Host]) -> list[dict]:
    ips = {h.ip for h in hosts}
    clean: list[dict] = []
    for item in items:
        if not isinstance(item, dict):
            console.print("[yellow]dropping non-object item[/yellow]")
            continue
        if item.get("ip") not in ips:
            console.print(f"[yellow]dropping unknown ip {item.get('ip')!r}[/yellow]")
            continue
        try:
            score = int(item.get("score", -1))
        except (TypeError, ValueError):
            score = -1
        if not 0 <= score <= 100:
            console.print(f"[yellow]dropping {item['ip']} — bad score[/yellow]")
            continue
        clean.append({
            "ip": item["ip"],
            "score": score,
            "rationale": str(item.get("rationale", ""))[:400],
            "vectors": [
                {
                    "technique": str(v.get("technique", ""))[:80],
                    "attack_id": str(v.get("attack_id", ""))[:20],
                    "note": str(v.get("note", ""))[:400],
                }
                for v in (item.get("vectors") or [])[:3]
                if isinstance(v, dict)
            ],
        })
    return clean


@app.command()
def main(
    xml: Path = typer.Argument(..., exists=True, readable=True, help="Nmap XML file."),
    output: Path = typer.Option(None, "--out", help="Write ranked JSON here."),
) -> None:
    hosts = parse_nmap(xml)
    if not hosts:
        console.print("[red]no live hosts in scan[/red]")
        raise typer.Exit(code=1)

    oll = ollama.Client(host=OLLAMA_HOST)
    resp = oll.chat(
        model=CHAT_MODEL,
        messages=[
            {"role": "system", "content": SYSTEM},
            {"role": "user", "content": build_prompt(hosts)},
        ],
        options={"temperature": 0.2, "num_ctx": 8192},
        format="json",
    )
    raw = resp["message"]["content"]

    try:
        items = extract_json_array(raw)
    except (ValueError, json.JSONDecodeError) as e:
        console.print(f"[red]model returned unparseable output: {e}[/red]")
        console.print(raw)
        raise typer.Exit(code=1)

    ranked = sorted(validate(items, hosts), key=lambda r: r["score"], reverse=True)

    table = Table(title=f"Triage — {xml.name}")
    table.add_column("Rank", style="dim")
    table.add_column("IP")
    table.add_column("Score", justify="right")
    table.add_column("Top Vector")
    table.add_column("Rationale")
    for i, r in enumerate(ranked, 1):
        top = r["vectors"][0]["technique"] if r["vectors"] else "-"
        table.add_row(str(i), r["ip"], str(r["score"]), top, r["rationale"])
    console.print(table)

    doc = {"source": str(xml), "hosts": [asdict(h) for h in hosts], "ranked": ranked}
    text = json.dumps(doc, indent=2, default=lambda o: asdict(o) if hasattr(o, "__dict__") else str(o))
    if output:
        output.write_text(text)
        console.print(f"[green]wrote {output}[/green]")
    else:
        print(text)


if __name__ == "__main__":
    app()

