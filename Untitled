console = Console()

SYSTEM = """You are a senior pentester answering a colleague's question using
ONLY the provided knowledge-base excerpts. Follow these rules strictly:

- If the excerpts do not contain the answer, say "Not covered by the corpus"
  and suggest what the operator should look up next. Do not guess.
- Cite every claim with the chunk id in square brackets, e.g. [cve-notes::003].
- Prefer excerpt text over general knowledge — this corpus is authoritative
  for the engagement.
- Keep answers under 250 words unless the operator asks for depth.
"""


@app.command()
def index() -> None:
    """Rebuild the vector store from ./corpus/*.md (delegates to index.py)."""
    here = Path(__file__).parent
    rc = subprocess.call([sys.executable, str(here / "index.py")])
    raise typer.Exit(code=rc)


@app.command()
def ask(
    question: str = typer.Argument(..., help="Pentest question to answer."),
    k: int = typer.Option(4, "--k", help="Number of chunks to retrieve."),
    show_context: bool = typer.Option(
        False, "--show-context", help="Print retrieved chunks before the answer."
    ),
) -> None:
    """Retrieve the top-k relevant chunks and answer the question."""
    if not DB_DIR.exists():
        console.print(f"[red]no vector store at {DB_DIR}[/red] — run `ragq index` first")
        raise typer.Exit(code=2)

    chroma = chromadb.PersistentClient(path=str(DB_DIR))
    coll = chroma.get_collection(COLLECTION)

    oll = ollama.Client(host=OLLAMA_HOST)
    q_vec = oll.embeddings(model=EMBED_MODEL, prompt=question)["embedding"]

    hits = coll.query(query_embeddings=[q_vec], n_results=k)
    ids = hits["ids"][0]
    docs = hits["documents"][0]
    metas = hits["metadatas"][0]

    context_blocks = []
    for cid, doc, meta in zip(ids, docs, metas):
        header = f"[{cid}] {meta.get('title', '')} (source: {meta.get('source', '')})"
        context_blocks.append(header + "\n" + doc)
    context = "\n\n---\n\n".join(context_blocks)

    if show_context:
        console.rule("retrieved context")
        console.print(context)
        console.rule("answer")

    user_msg = f"""Question:
{question}

Knowledge-base excerpts (cite by chunk id in brackets):

{context}
"""

    resp = oll.chat(
        model=CHAT_MODEL,
        messages=[
            {"role": "system", "content": SYSTEM},
            {"role": "user", "content": user_msg},
        ],
        options={"temperature": 0.2, "num_ctx": 8192},
    )
    answer = resp["message"]["content"]

    console.print(Markdown(answer))
    console.rule()
    console.print("[dim]cited sources:[/dim] " + ", ".join(ids))


if __name__ == "__main__":
    app()

