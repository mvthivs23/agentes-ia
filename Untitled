#!/usr/bin/env python3
"""finding-writer — draft a full Markdown finding card from a raw YAML.

Primary: Claude Sonnet 5 via the Anthropic API.
Fallback: local llama3.1:8b via Ollama.

The tool never crashes on model failure. If the primary API is unreachable it
retries once through Ollama with the same prompt. If the drafted markdown is
missing any required section it asks once for a follow-up patch. Whatever
finally comes out is written to outputs/<slug>-<ts>.md and its path printed.
"""

from __future__ import annotations

import os
import re
import sys
import time
from datetime import datetime
from pathlib import Path

import ollama
import typer
import yaml
from rich.console import Console

console = Console()
app = typer.Typer(add_completion=False, help="AI-drafted finding writer.")

ANTHROPIC_MODEL = os.environ.get("ANTHROPIC_MODEL", "claude-sonnet-5-20260101")
OLLAMA_MODEL = os.environ.get("OLLAMA_CHAT_MODEL", "llama3.1:8b")
OLLAMA_HOST = os.environ.get("OLLAMA_HOST", "http://127.0.0.1:11434")

REQUIRED = ("## Executive Summary", "## Technical Details", "## Impact", "## Remediation", "## References")

SYSTEM = """You are a senior penetration tester writing a formal finding card
for a client-facing report. Given a raw finding description, produce a
polished Markdown document with these exact top-level sections in this order:

    # <finding title>

    **Target:** ...
    **Severity:** ...
    **CVSS:** ...

    ## Executive Summary
    Two or three sentences a non-technical stakeholder can act on. State the
    business risk in plain language.

    ## Technical Details
    A precise description of the vulnerability, the reproduction steps, and
    the evidence. Preserve all IDs, URLs, and payloads from the raw evidence
    verbatim. Use fenced code blocks for HTTP requests and responses.

    ## Impact
    What an attacker can do with this. Tie it to the CIA triad and to any
    regulated data (PII, PCI, PHI). Include a realistic worst case.

    ## Remediation
    Ordered, concrete steps engineering can follow. Prefer specific control
    names ("enforce object-level authorization in the OrdersController")
    over generic advice ("validate input"). Include short-term mitigations
    if the full fix is not immediate.

    ## References
    A markdown bullet list. Include every reference from the input plus any
    additional standard sources (OWASP, CWE, NIST) that are directly relevant.

Never invent evidence, IDs, HTTP responses, or customer names that are not in
the input. Never speculate about the client's identity. Keep the tone neutral,
factual, and audit-ready.
"""


def slugify(text: str) -> str:
    s = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return s[:60] or "finding"


def build_user_prompt(raw: dict) -> str:
    parts = [
        f"Title: {raw.get('title', '(missing)')}",
        f"Target: {raw.get('target', '(missing)')}",
        f"Severity: {raw.get('severity', '(unspecified)')}",
    ]
    if raw.get("cvss"):
        parts.append(f"CVSS: {raw['cvss']}")
    parts.append("\nRaw evidence:\n" + str(raw.get("evidence", "")).rstrip())
    if raw.get("references"):
        parts.append("\nProvided references:")
        for r in raw["references"]:
            parts.append(f"- {r}")
    parts.append("\nDraft the finding card as instructed.")
    return "\n".join(parts)


def try_anthropic(user_prompt: str) -> str:
    try:
        import anthropic  # type: ignore
    except ImportError as e:
        raise RuntimeError(f"anthropic sdk missing: {e}") from e

    key = os.environ.get("ANTHROPIC_API_KEY", "").strip()
    if not key:
        raise RuntimeError("ANTHROPIC_API_KEY not set")

    client = anthropic.Anthropic(api_key=key)
    resp = client.messages.create(
        model=ANTHROPIC_MODEL,
        max_tokens=2048,
        system=SYSTEM,
        messages=[{"role": "user", "content": user_prompt}],
    )
    return "".join(block.text for block in resp.content if getattr(block, "type", "") == "text")


def try_ollama(user_prompt: str) -> str:
    oll = ollama.Client(host=OLLAMA_HOST)
    resp = oll.chat(
        model=OLLAMA_MODEL,
        messages=[
            {"role": "system", "content": SYSTEM},
            {"role": "user", "content": user_prompt},
        ],
        options={"temperature": 0.3, "num_ctx": 8192},
    )
    return resp["message"]["content"]


def draft(user_prompt: str) -> tuple[str, str]:
    """Return (markdown, model_id_used)."""
    try:
        md = try_anthropic(user_prompt)
        return md, ANTHROPIC_MODEL
    except Exception as e:
        console.print(f"[yellow]anthropic path failed: {e} — falling back to ollama[/yellow]")
        try:
            md = try_ollama(user_prompt)
            return md, OLLAMA_MODEL
        except Exception as ee:
            console.print(f"[red]ollama fallback also failed: {ee}[/red]")
            raise


def missing_sections(md: str) -> list[str]:
    return [s for s in REQUIRED if s not in md]


def patch_missing(md: str, missing: list[str], user_prompt: str) -> str:
    nudge = (
        "Your previous draft is missing these required sections: "
        + ", ".join(missing)
        + ". Rewrite the full document with every required section present. "
        + "Preserve everything you already wrote correctly."
    )
    full = user_prompt + "\n\nPrevious draft:\n" + md + "\n\n" + nudge
    try:
        return try_anthropic(full)
    except Exception:
        return try_ollama(full)


@app.command()
def main(
    yaml_path: Path = typer.Argument(..., exists=True, readable=True),
    out_dir: Path = typer.Option(Path("outputs"), "--out", help="Output directory."),
) -> None:
    raw = yaml.safe_load(yaml_path.read_text())
    if not isinstance(raw, dict) or "title" not in raw:
        console.print("[red]YAML must be a mapping with at least a 'title' key[/red]")
        raise typer.Exit(code=2)

    user_prompt = build_user_prompt(raw)
    md, used = draft(user_prompt)

    missing = missing_sections(md)
    if missing:
        console.print(f"[yellow]missing sections: {missing} — requesting patch[/yellow]")
        try:
            md = patch_missing(md, missing, user_prompt)
        except Exception as e:
            console.print(f"[red]patch attempt failed: {e}[/red]")
        missing = missing_sections(md)
        if missing:
            console.print(f"[red]final draft still missing: {missing}[/red]")

    out_dir.mkdir(parents=True, exist_ok=True)
    ts = datetime.now().strftime("%Y%m%d-%H%M%S")
    out_path = out_dir / f"{slugify(raw['title'])}-{ts}.md"
    out_path.write_text(md.rstrip() + "\n")

    console.print(f"[green]wrote {out_path}[/green]  [dim](model: {used})[/dim]")


if __name__ == "__main__":
    app()

